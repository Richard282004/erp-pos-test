# Solo para docker-compose local. Copiá a .env y completá.
# En la nube estas variables se configuran en cada plataforma (ver DEPLOY.md).

POSTGRES_DB=burger_pos
POSTGRES_USER=burger_user
POSTGRES_PASSWORD=cambia-esto

# >= 32 caracteres aleatorios:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

JWT_ACCESS_MIN=15
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL del backend para el build del frontend
VITE_API_URL=http://localhost:8000
