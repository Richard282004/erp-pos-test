# Copiá este archivo a .env y completá los valores.

# Conexión a Postgres
DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/burger_pos

# Clave para firmar los tokens JWT. OBLIGATORIA, >= 32 caracteres aleatorios.
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Minutos de validez del token de acceso
JWT_ACCESS_MIN=15

# Cookie "refresh" segura (solo HTTPS). true en producción.
COOKIE_SECURE=false

# Orígenes permitidos para el frontend (CSV)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
